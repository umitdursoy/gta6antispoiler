{
  "manifest_version": 3,
  "name": "GTA 6 Spoiler Gizleyici",
  "version": "1.5",
  "description": "Sayfa içeriğinde GTA 6 geçen öğeleri gizler.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}